              "name": "Filter Type",
              "type": "enum",
              "options": ["Lowpass 12dB", "Lowpass", "Highpass", "Peak"],
              "short_name": "TYPE",
              "viz": {
                "group": "flt",
                "role": "mode",
                "span": false
              },
              "default": "Lowpass"
