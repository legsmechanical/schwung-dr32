            {
              "key": "volume_clone",
              "name": "Volume",
              "type": "float",
              "min": -36.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "VOL",
              "viz": {
                "kind": "fader"
              },
              "default": 0.0
            }
          ],
          "knobs": ["ui_current_pad", "sample", "start", "end", "transpose", "detune", "choke", "volume_clone"],
          "child_key_overrides": {
            "ui_current_pad": "ui_current_pad"
          }
        },
        "pad_shape": {
