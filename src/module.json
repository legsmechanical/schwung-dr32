{
  "id": "dr32",
  "name": "DrumRack32",
  "abbrev": "DR32",
  "version": "0.3.2",
  "author": "legsmechanical",
  "license": "GPL-3.0-or-later",
  "description": "Ableton Move's Drum Rack with 32 pads instead of 16, where any pad can also be a synthesised drum. Loads Move's own .ablpreset drum kits and plays them through a reconstruction of the same Drum Sampler voice (playback region, transpose/detune, A-H-D / A-S-R envelope, four filter types, velocity modulation, choke groups, Punch), and lets any pad play a drum from SIMIAN, URCHIN, 9W9, 6W6, 8W8, CW-78 or ChowKick instead. Every pad has a Send A / Send B into the host's return buses.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "claims_edit_ccs": true,
    "component_type": "sound_generator",
    "chain_params": [
      {
        "key": "kit",
        "name": "Kit",
        "type": "filepath",
        "root": "/data",
        "start_path": "/data/UserData/UserLibrary/Track Presets",
        "filter": [".ablpreset", ".json"],
        "default": "",
        "live_preview": true,
        "browser_hooks": {
          "on_open": [
            {
              "key": "kit_mark",
              "value": "1"
            }
          ],
          "on_cancel": [
            {
              "key": "kit_restore",
              "value": "1"
            }
          ],
          "on_commit": [
            {
              "key": "kit_mark",
              "value": "0"
            }
          ]
        }
      },
      {
        "key": "master",
        "name": "Master",
        "type": "float",
        "min": 0.0,
        "max": 2.0,
        "step": 0.02,
        "default": 1.0
      },
      {
        "key": "ui_engine",
        "name": "Engine",
        "type": "int",
        "min": 0,
        "max": 54,
        "default": 0
      },
      {
        "key": "ui_family",
        "name": "Instrument",
        "type": "int",
        "min": 0,
        "max": 7,
        "default": 0
      }
    ],
    "ui_hierarchy": {
      "pad_layout": "drums",
      "levels": {
        "root": {
          "name": "DrumRack32",
          "params": [
            {
              "level": "kits",
              "label": "Category"
            },
            {
              "level": "pads",
              "label": "Pad"
            },
            {
              "level": "pad_shape",
              "label": "Shape"
            },
            {
              "level": "pad_mix",
              "label": "Mix"
            },
            {
              "level": "output",
              "label": "Master"
            }
          ],
          "knobs": []
        },
        "pads": {
          "name": "Pad",
          "child_prefix": "pad",
          "child_count": 32,
          "child_index_base": 1,
          "child_label": "Pad",
          "child_index_param": "ui_current_pad",
          "child_note_base": 36,
