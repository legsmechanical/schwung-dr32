{
  "id": "dr32",
  "name": "Drum Rack 32",
  "abbrev": "DR32",
  "version": "0.2.0",
  "author": "legsmechanical",
  "license": "MIT",
  "description": "Clone of Move's native Drum Rack with 32 pads instead of 16. Loads Move's own .ablpreset drum kits directly from the User Library, with the same Drum Sampler voice: playback region, transpose/detune, A-H-D / A-S-R envelope, four filter types, velocity modulation and choke groups.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "claims_edit_ccs": true,
    "component_type": "sound_generator",
    "chain_params": [
      {
        "key": "kit",
        "name": "Kit",
        "type": "filepath",
        "root": "/data",
        "start_path": "/data/UserData/UserLibrary/Track Presets",
        "filter": [
          ".ablpreset",
          ".json"
        ],
        "default": "",
        "live_preview": true,
        "browser_hooks": {
          "on_open": [
            {
              "key": "kit_mark",
              "value": "1"
            }
          ],
          "on_cancel": [
            {
              "key": "kit_restore",
              "value": "1"
            }
          ],
          "on_commit": [
            {
              "key": "kit_mark",
              "value": "0"
            }
          ]
        }
      },
      {
        "key": "master",
        "name": "Master",
        "type": "float",
        "min": 0.0,
        "max": 2.0,
        "step": 0.02,
        "default": 1.0
      }
    ],
    "ui_hierarchy": {
      "pad_layout": "drums",
      "levels": {
        "root": {
          "name": "Drum Rack 32",
          "params": [
            {
              "level": "kit_src",
              "label": "Kit"
            },
            {
              "key": "ui_auto_select_pad",
              "name": "Follow Pads",
              "type": "enum",
              "options": [
                "on",
                "off"
              ],
              "short_name": "FOLLW",
              "viz": {
                "kind": "switch"
              }
            },
            {
              "level": "pads",
              "label": "Pads"
            },
            {
              "level": "fx",
              "label": "Effects"
            },
            {
              "key": "master",
              "name": "Master",
              "type": "float",
              "min": 0.0,
              "max": 2.0,
              "step": 0.02,
              "short_name": "MASTR"
            }
          ],
          "knobs": [
            "master",
            "ui_auto_select_pad"
          ]
        },
        "pads": {
          "name": "Pads",
          "child_prefix": "pad",
          "child_count": 32,
          "child_label": "Pad",
          "child_index_param": "ui_current_pad",
          "child_note_base": 36,
          "child_select_param": "ui_current_pad",
          "child_press_param": "ui_live_press",
          "child_press_note_param": "ui_live_note",
          "params": [
            {
              "key": "sample_move",
              "name": "Move",
              "short_name": "MOVE",
              "type": "filepath",
              "root": "/data/CoreLibrary/Samples",
              "start_path": "/data/CoreLibrary/Samples",
              "filter": [
                ".wav",
                ".aif",
                ".aiff"
              ],
              "live_preview": true,
              "browser_hooks": {
                "on_open": [
                  {
                    "key": "ui_auto_select_pad",
                    "value": "off",
                    "restore": true
                  }
                ]
              }
            },
            {
              "key": "sample_user",
              "name": "User",
              "short_name": "USER",
              "type": "filepath",
              "root": "/data/UserData/UserLibrary/Samples",
              "start_path": "/data/UserData/UserLibrary/Samples",
              "filter": [
                ".wav",
                ".aif",
                ".aiff"
              ],
              "live_preview": true,
              "browser_hooks": {
                "on_open": [
                  {
                    "key": "ui_auto_select_pad",
                    "value": "off",
                    "restore": true
                  }
                ]
              }
            },
            {
              "key": "start",
              "name": "Start",
              "type": "wav_position",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "short_name": "STRT",
              "mode": "start",
              "display_unit": "percent",
              "filepath_param": "sample_move"
            },
            {
              "key": "end",
              "name": "End",
              "short_name": "END",
              "type": "wav_position",
              "mode": "end",
              "display_unit": "percent",
              "filepath_param": "sample_move",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "transpose",
              "name": "Transpose",
              "type": "int",
              "min": -48,
              "max": 48,
              "unit": "st",
              "short_name": "TRSP"
            },
            {
              "key": "detune",
              "name": "Detune",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0,
              "unit": "ct",
              "short_name": "DETN"
            },
            {
              "key": "choke",
              "name": "Choke",
              "type": "int",
              "min": 0,
              "max": 16,
              "short_name": "CHOKE"
            },
            {
              "key": "browse",
              "name": "Browse Folder",
              "short_name": "BRWS",
              "type": "int",
              "min": 0,
              "max": 511
            },
            {
              "key": "attack",
              "name": "Attack",
              "type": "float",
              "min": 0.0001,
              "max": 20.0,
              "step": 0.001,
              "unit": "s",
              "short_name": "ATK",
              "viz": {
                "group": "amp",
                "role": "attack"
              }
            },
            {
              "key": "decay",
              "name": "Decay",
              "type": "float",
              "min": 0.001,
              "max": 60.0,
              "step": 0.01,
              "unit": "s",
              "short_name": "DCY",
              "viz": {
                "group": "amp",
                "role": "decay"
              }
            },
            {
              "key": "hold",
              "name": "Hold",
              "type": "float",
              "min": 0.001,
              "max": 60.0,
              "step": 0.01,
              "unit": "s",
              "short_name": "HOLD"
            },
            {
              "key": "env_mode",
              "name": "Envelope",
              "type": "enum",
              "options": [
                "A-H-D",
                "A-S-R"
              ],
              "short_name": "ENV"
            },
            {
              "key": "volume",
              "name": "Volume",
              "type": "float",
              "min": -36.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "VOL",
              "viz": {
                "kind": "fader"
              }
            },
            {
              "key": "pan",
              "name": "Pan",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0,
              "short_name": "PAN"
            },
            {
              "key": "punch",
              "name": "Punch",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "default": 0.0,
              "short_name": "PUNCH"
            },
            {
              "key": "punch_time",
              "name": "Punch Time",
              "type": "float",
              "min": 0.06,
              "max": 1.0,
              "step": 0.01,
              "unit": "s",
              "default": 0.3,
              "short_name": "PTIME"
            },
            {
              "key": "cutoff",
              "name": "Filter Freq",
              "type": "float",
              "min": 30.0,
              "max": 22000.0,
              "step": 50.0,
              "unit": "Hz",
              "short_name": "CUT",
              "viz": {
                "group": "flt",
                "role": "cutoff"
              }
            },
            {
              "key": "resonance",
              "name": "Filter Reso",
              "type": "float",
              "min": 0.0,
              "max": 0.9,
              "step": 0.01,
              "short_name": "RES",
              "viz": {
                "group": "flt",
                "role": "resonance"
              }
            },
            {
              "key": "filter_type",
              "name": "Filter Type",
              "type": "enum",
              "options": [
                "Lowpass 12dB",
                "Lowpass",
                "Highpass",
                "Peak"
              ],
              "short_name": "TYPE",
              "viz": {
                "group": "flt",
                "role": "mode"
              }
            },
            {
              "key": "filter_on",
              "name": "Filter On",
              "short_name": "FILT",
              "type": "int",
              "min": 0,
              "max": 1,
              "viz": {
                "kind": "switch"
              }
            },
            {
              "key": "send1",
              "name": "Send 1",
