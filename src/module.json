{
  "id": "dr32",
  "name": "Drum Rack 32",
  "abbrev": "DR32",
  "version": "0.1.0",
  "author": "legsmechanical",
  "license": "MIT",
  "description": "Clone of Move's native Drum Rack with 32 pads instead of 16. Loads Move's own .ablpreset drum kits directly from the User Library, with the same Drum Sampler voice: playback region, transpose/detune, A-H-D / A-S-R envelope, four filter types, velocity modulation and choke groups.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "component_type": "sound_generator",
    "chain_params": [
      {
        "key": "kit",
        "label": "Kit",
        "type": "filepath",
        "root": "/data/UserData/UserLibrary/Track Presets",
        "start_path": "/data/UserData/UserLibrary/Track Presets",
        "filter": ".ablpreset",
        "requireContains": "drumRack"
      }
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Drum Rack 32",
          "params": [
            { "key": "kit", "label": "Kit" },
            { "key": "pad", "label": "Pad", "type": "int", "min": 1, "max": 32, "default": 1 },
            { "key": "transpose", "label": "Transpose", "type": "float", "min": -48, "max": 48, "default": 0, "step": 1, "unit": "st" },
            { "key": "attack", "label": "Attack", "type": "float", "min": 0.0001, "max": 10, "default": 0.0001, "step": 0.001, "unit": "s" },
            { "key": "hold", "label": "Hold", "type": "float", "min": 0.0, "max": 60.0, "default": 0.3, "step": 0.01, "unit": "s" },
            { "key": "decay", "label": "Decay", "type": "float", "min": 0.001, "max": 60.0, "default": 1.0, "step": 0.01, "unit": "s" },
            { "key": "cutoff", "label": "Filter Freq", "type": "float", "min": 20, "max": 22000, "default": 22000, "step": 50, "unit": "Hz" },
            { "key": "resonance", "label": "Filter Reso", "type": "float", "min": 0.0, "max": 1.0, "default": 0.0, "step": 0.01 },
            { "key": "pan", "label": "Pan", "type": "float", "min": -1.0, "max": 1.0, "default": 0.0, "step": 0.02 },
            { "key": "volume", "label": "Volume", "type": "float", "min": -36.0, "max": 12.0, "default": 0.0, "step": 0.5, "unit": "dB" },
            { "key": "master", "label": "Master", "type": "float", "min": 0.0, "max": 2.0, "default": 1.0, "step": 0.02 }
          ],
          "knobs": [
            "pad", "transpose", "attack", "hold", "decay", "cutoff", "resonance", "volume"
          ]
        }
      }
    }
  }
}
