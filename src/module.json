{
  "id": "dr32",
  "name": "Drum Rack 32",
  "abbrev": "DR32",
  "version": "0.1.0",
  "author": "legsmechanical",
  "license": "MIT",
  "description": "Clone of Move's native Drum Rack with 32 pads instead of 16. Loads Move's own .ablpreset drum kits directly from the User Library, with the same Drum Sampler voice: playback region, transpose/detune, A-H-D / A-S-R envelope, four filter types, velocity modulation and choke groups.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "component_type": "sound_generator",
    "chain_params": [
      {
        "key": "kit",
        "name": "Kit",
        "type": "filepath",
        "root": "/data",
        "start_path": "/data/UserData/UserLibrary/Track Presets",
        "filter": [
          ".ablpreset",
          ".json"
        ],
        "default": ""
      },
      {
        "key": "master",
        "name": "Master",
        "type": "float",
        "min": 0.0,
        "max": 2.0,
        "step": 0.02,
        "default": 1.0
      }
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Drum Rack 32",
          "params": [
            {
              "key": "kit",
              "name": "Kit",
              "type": "filepath",
              "root": "/data",
              "start_path": "/data/UserData/UserLibrary/Track Presets",
              "filter": [
                ".ablpreset",
                ".json"
              ]
            },
            {
              "level": "pads",
              "label": "Pads"
            },
            {
              "key": "master",
              "name": "Master",
              "type": "float",
              "min": 0.0,
              "max": 2.0,
              "step": 0.02
            }
          ],
          "knobs": [
            "master"
          ]
        },
        "pads": {
          "name": "Pads",
          "child_prefix": "pad",
          "child_count": 32,
          "child_label": "Pad",
          "params": [
            {
              "key": "sample",
              "name": "Sample",
              "type": "filepath",
              "root": "/data",
              "start_path": "/data/UserData/UserLibrary/Samples",
              "filter": [
                ".wav",
                ".aif",
                ".aiff"
              ],
              "live_preview": true
            },
            {
              "key": "transpose",
              "name": "Transpose",
              "type": "int",
              "min": -48,
              "max": 48,
              "unit": "st"
            },
            {
              "key": "attack",
              "name": "Attack",
              "type": "float",
              "min": 0.0001,
              "max": 20.0,
              "step": 0.001,
              "unit": "s"
            },
            {
              "key": "hold",
              "name": "Hold",
              "type": "float",
              "min": 0.001,
              "max": 60.0,
              "step": 0.01,
              "unit": "s"
            },
            {
              "key": "decay",
              "name": "Decay",
              "type": "float",
              "min": 0.001,
              "max": 60.0,
              "step": 0.01,
              "unit": "s"
            },
            {
              "key": "cutoff",
              "name": "Filter Freq",
              "type": "float",
              "min": 30.0,
              "max": 22000.0,
              "step": 50.0,
              "unit": "Hz"
            },
            {
              "key": "resonance",
              "name": "Filter Reso",
              "type": "float",
              "min": 0.0,
              "max": 0.9,
              "step": 0.01
            },
            {
              "key": "filter_type",
              "name": "Filter Type",
              "type": "enum",
              "options": [
                "Lowpass 12dB",
                "Lowpass",
                "Highpass",
                "Peak"
              ]
            },
            {
              "key": "env_mode",
              "name": "Envelope",
              "type": "enum",
              "options": [
                "A-H-D",
                "A-S-R"
              ]
            },
            {
              "key": "pan",
              "name": "Pan",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0
            },
            {
              "key": "volume",
              "name": "Volume",
              "type": "float",
              "min": -36.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB"
            },
            {
              "key": "choke",
              "name": "Choke",
              "type": "int",
              "min": 0,
              "max": 16
            },
            {
              "key": "detune",
              "name": "Detune",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0,
              "unit": "ct"
            },
            {
              "key": "start",
              "name": "Start",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "length",
              "name": "Length",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "note",
              "name": "Note",
              "type": "int",
              "min": 0,
              "max": 127
            }
          ],
          "knobs": [
            "transpose",
            "attack",
            "hold",
            "decay",
            "cutoff",
            "resonance",
            "pan",
            "volume"
          ]
        }
      }
    }
  }
}
