{
  "id": "dr32",
  "name": "DrumRack32",
  "abbrev": "DR32",
  "version": "0.4.1",
  "author": "legsmechanical",
  "license": "GPL-3.0-or-later",
  "description": "Ableton Move's Drum Rack with 32 pads instead of 16, where any pad can also be a synthesised drum. Loads Move's own .ablpreset drum kits and plays them through a reconstruction of the same Drum Sampler voice (playback region, transpose/detune, A-H-D / A-S-R envelope, four filter types, velocity modulation, choke groups, Punch), and lets any pad play a drum from SIMIAN, URCHIN, 9W9, 6W6, 8W8, CW-78, ChowKick or DR32's own FM drum instead. Every pad has a Send A / Send B into the host's return buses.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "claims_edit_ccs": true,
    "component_type": "sound_generator",
    "chain_params": [
      {
        "key": "kit",
        "name": "Kit",
        "type": "filepath",
        "root": "/data",
        "start_path": "/data/UserData/UserLibrary/Track Presets",
        "filter": [".ablpreset", ".json"],
        "default": "",
        "live_preview": true,
        "browser_hooks": {
          "on_open": [
            {
              "key": "kit_mark",
              "value": "1"
            }
          ],
          "on_cancel": [
            {
              "key": "kit_restore",
              "value": "1"
            }
          ],
          "on_commit": [
            {
              "key": "kit_mark",
              "value": "0"
            }
          ]
        }
      },
      {
        "key": "master",
        "name": "Master",
        "type": "float",
        "min": 0.0,
        "max": 2.0,
        "step": 0.02,
        "default": 1.0
      },
      {
        "key": "ui_engine",
        "name": "Engine",
        "type": "int",
        "min": 0,
        "max": 58,
        "default": 0
      },
      {
        "key": "ui_family",
        "name": "Instrument",
        "type": "int",
        "min": 0,
        "max": 8,
        "default": 0
      }
    ],
    "ui_hierarchy": {
      "pad_layout": "drums",
      "levels": {
        "root": {
          "name": "DrumRack32",
          "params": [
            {
              "level": "kits",
              "label": "Category"
            },
            {
              "level": "pads",
              "label": "Pad"
            },
            {
              "level": "pad_shape",
              "label": "Shape"
            },
            {
              "level": "pad_mix",
              "label": "Mix"
            },
            {
              "level": "pad_stereo",
              "label": "Stereo"
            },
            {
              "level": "output",
              "label": "Master"
            },
            {
              "level": "resample",
              "label": "Resample"
            }
          ],
          "knobs": []
        },
        "pads": {
          "name": "Pad",
          "child_prefix": "pad",
          "child_count": 32,
          "child_index_base": 1,
          "child_label": "Pad",
          "child_index_param": "ui_current_pad",
          "child_note_base": 36,
          "child_copy_keys": ["sample", "model", "start", "end", "transpose", "detune", "choke", "gain", "cell_volume", "vel_vol", "attack", "hold", "decay", "env_mode", "volume", "pan", "punch", "punch_time", "filter_on", "filter_type", "cutoff", "resonance", "peak_gain", "mod_target", "mod_amount", "pitch_env", "send_a", "send_b", "wide", "wide_freq", "wide_mode", "wide_time", "wide_comp", "wide_late"],
          "child_press_param": "ui_live_press",
          "child_press_note_param": "ui_live_note",
          "params": [
            {
              "key": "ui_current_pad",
              "name": "Pad",
              "short_name": "PAD",
              "type": "int",
              "min": 1,
              "max": 32,
              "default": 1
            },
            {
              "key": "sample",
              "name": "Engine",
              "short_name": "ENGN",
              "type": "canvas",
              "canvas_script": "browser.js",
              "enterable": true,
              "show_footer": false
            },
            {
              "key": "start",
              "name": "Start",
              "type": "wav_position",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "short_name": "STRT",
              "mode": "start",
              "display_unit": "percent",
              "filepath_param": "sample",
              "default": 0.0,
              "visible_if": {
                "param": "ui_engine",
                "equals": 0
              }
            },
            {
              "key": "end",
              "name": "End",
              "short_name": "END",
              "type": "wav_position",
              "mode": "end",
              "display_unit": "percent",
              "filepath_param": "sample",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "default": 1.0,
              "visible_if": {
                "param": "ui_engine",
                "equals": 0
              }
            },
            {
              "key": "transpose",
              "name": "Transpose",
              "type": "int",
              "min": -48,
              "max": 48,
              "unit": "st",
              "short_name": "TRSP",
              "default": 0
            },
            {
              "key": "detune",
              "name": "Detune",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0,
              "unit": "ct",
              "short_name": "DETN",
              "default": 0.0
            },
            {
              "key": "choke",
              "name": "Choke",
              "type": "int",
              "min": 0,
              "max": 16,
              "short_name": "CHOKE",
              "default": 0
            },
            {
              "key": "volume_clone",
              "name": "Volume",
              "type": "float",
              "min": -36.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "VOL",
              "viz": {
                "kind": "fader"
              },
              "default": 0.0
            }
          ],
          "knobs": ["ui_current_pad", "sample", "start", "end", "transpose", "detune", "choke", "volume_clone"],
          "child_key_overrides": {
            "ui_current_pad": "ui_current_pad"
          }
        },
        "pad_shape": {
          "name": "Shape",
          "child_prefix": "pad",
          "child_count": 32,
          "child_index_base": 1,
          "child_label": "Pad",
          "child_index_param": "ui_current_pad",
          "child_copy_keys": ["sample", "model", "start", "end", "transpose", "detune", "choke", "gain", "cell_volume", "vel_vol", "attack", "hold", "decay", "env_mode", "volume", "pan", "punch", "punch_time", "filter_on", "filter_type", "cutoff", "resonance", "peak_gain", "mod_target", "mod_amount", "pitch_env", "send_a", "send_b", "wide", "wide_freq", "wide_mode", "wide_time", "wide_comp", "wide_late"],
          "params": [
            {
              "key": "atk_knob",
              "name": "Attack",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.0001,
              "short_name": "ATK",
              "default": 0.0,
              "card_script": "env_card.js#dr32_atk_card",
              "card_w": 90.0,
              "card_h": 15.0,
              "viz": {
                "group": "amp",
                "role": "attack"
              }
            },
            {
              "key": "hold_knob",
              "name": "Hold",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.0001,
              "short_name": "HOLD",
              "default": 0.3569,
              "card_script": "env_card.js#dr32_hold_card",
              "card_w": 90.0,
              "card_h": 15.0,
              "viz": {
                "group": "amp",
                "role": "hold"
              }
            },
            {
              "key": "dcy_knob",
              "name": "Decay",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.0001,
              "short_name": "DCY",
              "default": 0.5,
              "card_script": "env_card.js#dr32_dcy_card",
              "card_w": 90.0,
              "card_h": 15.0,
              "viz": {
                "group": "amp",
                "role": "decay"
              }
            },
            {
              "key": "env_mode",
              "name": "Envelope",
              "type": "enum",
              "options": ["Trigger", "Gate"],
              "short_options": ["Triggr", "Gate"],
              "short_name": "ENV",
              "default": "Trigger",
              "viz": {
                "group": "amp",
                "role": "mode",
                "span": false
              }
            },
            {
              "key": "cutoff",
              "name": "Filter Freq",
              "type": "float",
              "min": 30.0,
              "max": 22000.0,
              "step": 50.0,
              "unit": "Hz",
              "short_name": "CUT",
              "viz": {
                "group": "flt",
                "role": "cutoff"
              },
              "default": 22000.0
            },
            {
              "key": "resonance",
              "name": "Filter Reso",
              "type": "float",
              "min": 0.0,
              "max": 0.9,
              "step": 0.01,
              "short_name": "RES",
              "viz": {
                "group": "flt",
                "role": "resonance"
              },
              "default": 0.0,
              "visible_if": {
                "param": "filter_type",
                "not_equals": "Peak"
              }
            },
            {
              "key": "peak_db",
              "name": "Filter Gain",
              "type": "float",
              "min": -12.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "GAIN",
              "viz": {
                "group": "flt",
                "role": "resonance"
              },
              "default": 0.0,
              "visible_if": {
                "param": "filter_type",
                "equals": "Peak"
              }
            },
            {
              "key": "filter_type",
              "name": "Filter Type",
              "type": "enum",
              "options": ["Lowpass 12dB", "Lowpass", "Highpass", "Peak"],
              "short_name": "TYPE",
              "viz": {
                "group": "flt",
                "role": "mode",
                "span": false
              },
              "default": "Lowpass"
            },
            {
              "key": "filter_on",
              "name": "Filter On",
              "short_name": "FILT",
              "type": "int",
              "min": 0,
              "max": 1,
              "viz": {
                "kind": "switch"
              },
              "default": 0
            }
          ],
          "knobs": ["atk_knob", "hold_knob", "dcy_knob", "env_mode", "cutoff", "resonance", "peak_db", "filter_type", "filter_on"],
          "child_key_overrides": {
            "ui_current_pad": "ui_current_pad"
          },
          "visible_if": {
            "param": "ui_engine",
            "equals": 0
          }
        },
        "pad_mix": {
          "name": "Mix",
          "child_prefix": "pad",
          "child_count": 32,
          "child_index_base": 1,
          "child_label": "Pad",
          "child_index_param": "ui_current_pad",
          "child_copy_keys": ["sample", "model", "start", "end", "transpose", "detune", "choke", "gain", "cell_volume", "vel_vol", "attack", "hold", "decay", "env_mode", "volume", "pan", "punch", "punch_time", "filter_on", "filter_type", "cutoff", "resonance", "peak_gain", "mod_target", "mod_amount", "pitch_env", "send_a", "send_b", "wide", "wide_freq", "wide_mode", "wide_time", "wide_comp", "wide_late"],
          "params": [
            {
              "key": "vel_vol",
              "name": "Vel Vol",
              "short_name": "VVOL",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "default": 0.35,
              "viz": false
            },
            {
              "key": "volume",
              "name": "Volume",
              "type": "float",
              "min": -36.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "VOL",
              "viz": {
                "kind": "fader"
              },
              "default": 0.0
            },
            {
              "key": "pan",
              "name": "Pan",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0,
              "short_name": "PAN",
              "default": 0.0
            },
            {
              "key": "link",
              "name": "Link",
              "short_name": "LINK",
              "type": "enum",
              "options": ["One", "All"],
              "default": "One",
              "viz": {
                "kind": "switch"
              }
            },
            {
              "key": "send_a",
              "name": "Send A",
              "type": "float",
              "min": -70.0,
              "max": 6.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "SNDA",
              "default": -70.0
            },
            {
              "key": "send_b",
              "name": "Send B",
              "type": "float",
              "min": -70.0,
              "max": 6.0,
              "step": 0.5,
              "unit": "dB",
              "short_name": "SNDB",
              "default": -70.0
            },
            {
              "key": "punch",
              "name": "Punch",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "default": 0.0,
              "short_name": "PUNCH",
              "visible_if": {
                "param": "ui_engine",
                "equals": 0
              }
            },
            {
              "key": "punch_time",
              "name": "Punch Time",
              "type": "float",
              "min": 0.06,
              "max": 1.0,
              "step": 0.01,
              "unit": "s",
              "default": 0.3,
              "short_name": "PTIME",
              "visible_if": {
                "param": "ui_engine",
                "equals": 0
              }
            }
          ],
          "knobs": ["vel_vol", "volume", "pan", "link", "send_a", "send_b", "punch", "punch_time"],
          "child_key_overrides": {
            "ui_current_pad": "ui_current_pad",
            "link": "link"
          }
        },
        "pad_stereo": {
          "name": "Stereo",
          "child_prefix": "pad",
          "child_count": 32,
          "child_index_base": 1,
          "child_label": "Pad",
          "child_index_param": "ui_current_pad",
          "child_copy_keys": ["sample", "model", "start", "end", "transpose", "detune", "choke", "gain", "cell_volume", "vel_vol", "attack", "hold", "decay", "env_mode", "volume", "pan", "punch", "punch_time", "filter_on", "filter_type", "cutoff", "resonance", "peak_gain", "mod_target", "mod_amount", "pitch_env", "send_a", "send_b", "wide", "wide_freq", "wide_mode", "wide_time", "wide_comp", "wide_late"],
          "params": [
            {
              "key": "wide_mode",
              "name": "Wide Mode",
              "short_name": "WMODE",
              "type": "enum",
              "options": ["Comb", "Haas", "Disperse"],
              "default": "Comb"
            },
            {
              "key": "wide",
              "name": "Wide",
              "short_name": "WIDE",
              "type": "int",
              "min": -100,
              "max": 100,
              "unit": "%",
              "default": 0
            },
            {
              "key": "wide_freq",
              "name": "Wide Freq",
              "short_name": "WFREQ",
              "type": "int",
              "min": 20,
              "max": 4000,
              "unit": "Hz",
              "default": 150
            },
            {
              "key": "wide_time",
              "name": "Wide Time",
              "short_name": "TIME",
              "type": "float",
              "min": 0.0,
              "max": 12.0,
              "step": 0.1,
              "unit": "ms",
              "default": 0.0
            },
            {
              "key": "wide_comp",
              "name": "Wide Comp",
              "short_name": "COMP",
              "type": "enum",
              "options": ["Off", "On"],
              "default": "Off"
            },
            {
              "key": "wide_late",
              "name": "Late Level",
              "short_name": "LATE",
              "type": "float",
              "min": -12.0,
              "max": 12.0,
              "step": 0.1,
              "unit": "dB",
              "default": 0.0,
              "visible_if": {
                "param": "wide_mode",
                "equals": "Haas"
              }
            }
          ],
          "knobs": ["wide_mode", "wide", "wide_freq", "wide_time", "wide_comp", "wide_late"],
          "child_key_overrides": {
            "ui_current_pad": "ui_current_pad"
          }
        },
        "output": {
          "name": "Master",
          "params": [
            {
              "key": "master",
              "name": "Master",
              "short_name": "MASTR",
              "type": "float",
              "min": 0.0,
              "max": 2.0,
              "step": 0.02,
              "default": 1.0
            }
          ],
          "knobs": ["master"]
        },
        "resample": {
          "name": "Resample",
          "params": [
            {
              "key": "resample",
              "name": "Resample",
              "type": "canvas",
              "canvas_script": "resample.js",
              "as_page": true,
              "enterable": true,
              "extra_keys": ["rs_status"]
            }
          ],
          "knobs": ["master"]
        },
        "kits": {
          "name": "Category",
          "items_param": "kit_cat_items",
          "select_param": "kit_cat",
          "navigate_to": "kit_list",
          "params": [
            {
              "level": "kit_list",
              "label": "Kit"
            }
          ]
        },
        "kit_list": {
          "name": "Kit",
          "list_param": "kit_index",
          "count_param": "kit_count",
          "name_param": "kit_name"
        }
      }
    }
  },
  "min_host_version": "1.5.0"
}
