{
  "id": "dr32",
  "name": "Drum Rack 32",
  "abbrev": "DR32",
  "version": "0.1.0",
  "author": "legsmechanical",
  "license": "MIT",
  "description": "Clone of Move's native Drum Rack with 32 pads instead of 16. Loads Move's own .ablpreset drum kits directly from the User Library, with the same Drum Sampler voice: playback region, transpose/detune, A-H-D / A-S-R envelope, four filter types, velocity modulation and choke groups.",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": false,
    "chainable": true,
    "component_type": "sound_generator",
    "chain_params": [
      {
        "key": "kit",
        "name": "Kit",
        "type": "filepath",
        "root": "/data",
        "start_path": "/data/UserData/UserLibrary/Track Presets",
        "filter": [
          ".ablpreset",
          ".json"
        ],
        "default": "",
        "live_preview": true,
        "browser_hooks": {
          "on_open": [
            {
              "key": "kit_mark",
              "value": "1"
            }
          ],
          "on_cancel": [
            {
              "key": "kit_restore",
              "value": "1"
            }
          ],
          "on_commit": [
            {
              "key": "kit_mark",
              "value": "0"
            }
          ]
        }
      },
      {
        "key": "master",
        "name": "Master",
        "type": "float",
        "min": 0.0,
        "max": 2.0,
        "step": 0.02,
        "default": 1.0
      }
    ],
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Drum Rack 32",
          "params": [
            {
              "key": "kit",
              "name": "Kit",
              "type": "filepath",
              "root": "/data",
              "start_path": "/data/UserData/UserLibrary/Track Presets",
              "filter": [
                ".ablpreset",
                ".json"
              ],
              "live_preview": true,
              "browser_hooks": {
                "on_open": [
                  {
                    "key": "kit_mark",
                    "value": "1"
                  }
                ],
                "on_cancel": [
                  {
                    "key": "kit_restore",
                    "value": "1"
                  }
                ],
                "on_commit": [
                  {
                    "key": "kit_mark",
                    "value": "0"
                  }
                ]
              }
            },
            {
              "level": "pads",
              "label": "Pads"
            },
            {
              "level": "fx",
              "label": "Effects"
            },
            {
              "key": "master",
              "name": "Master",
              "type": "float",
              "min": 0.0,
              "max": 2.0,
              "step": 0.02
            }
          ],
          "knobs": [
            "master"
          ]
        },
        "pads": {
          "name": "Pads",
          "child_prefix": "pad",
          "child_count": 32,
          "child_label": "Pad",
          "params": [
            {
              "key": "sample",
              "name": "Sample",
              "type": "filepath",
              "root": "/data",
              "start_path": "/data/UserData/UserLibrary/Samples",
              "filter": [
                ".wav",
                ".aif",
                ".aiff"
              ],
              "live_preview": true
            },
            {
              "key": "transpose",
              "name": "Transpose",
              "type": "int",
              "min": -48,
              "max": 48,
              "unit": "st"
            },
            {
              "key": "attack",
              "name": "Attack",
              "type": "float",
              "min": 0.0001,
              "max": 20.0,
              "step": 0.001,
              "unit": "s"
            },
            {
              "key": "hold",
              "name": "Hold",
              "type": "float",
              "min": 0.001,
              "max": 60.0,
              "step": 0.01,
              "unit": "s"
            },
            {
              "key": "decay",
              "name": "Decay",
              "type": "float",
              "min": 0.001,
              "max": 60.0,
              "step": 0.01,
              "unit": "s"
            },
            {
              "key": "cutoff",
              "name": "Filter Freq",
              "type": "float",
              "min": 30.0,
              "max": 22000.0,
              "step": 50.0,
              "unit": "Hz"
            },
            {
              "key": "resonance",
              "name": "Filter Reso",
              "type": "float",
              "min": 0.0,
              "max": 0.9,
              "step": 0.01
            },
            {
              "key": "filter_type",
              "name": "Filter Type",
              "type": "enum",
              "options": [
                "Lowpass 12dB",
                "Lowpass",
                "Highpass",
                "Peak"
              ]
            },
            {
              "key": "env_mode",
              "name": "Envelope",
              "type": "enum",
              "options": [
                "A-H-D",
                "A-S-R"
              ]
            },
            {
              "key": "pan",
              "name": "Pan",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0
            },
            {
              "key": "volume",
              "name": "Volume",
              "type": "float",
              "min": -36.0,
              "max": 12.0,
              "step": 0.5,
              "unit": "dB"
            },
            {
              "key": "choke",
              "name": "Choke",
              "type": "int",
              "min": 0,
              "max": 16
            },
            {
              "key": "detune",
              "name": "Detune",
              "type": "float",
              "min": -50.0,
              "max": 50.0,
              "step": 1.0,
              "unit": "ct"
            },
            {
              "key": "start",
              "name": "Start",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "length",
              "name": "Length",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "note",
              "name": "Note",
              "type": "int",
              "min": 0,
              "max": 127
            },
            {
              "key": "send1",
              "name": "Send 1",
              "type": "float",
              "min": -70.0,
              "max": 6.0,
              "step": 0.5,
              "unit": "dB"
            },
            {
              "key": "send2",
              "name": "Send 2",
              "type": "float",
              "min": -70.0,
              "max": 6.0,
              "step": 0.5,
              "unit": "dB"
            }
          ],
          "knobs": [
            "transpose",
            "attack",
            "hold",
            "decay",
            "cutoff",
            "resonance",
            "pan",
            "volume"
          ]
        },
        "send1": {
          "name": "Send 1",
          "params": [
            {
              "key": "send1_type",
              "name": "Type",
              "type": "enum",
              "options": [
                "Off",
                "Plate",
                "Room",
                "Hall"
              ]
            },
            {
              "key": "send1_p1",
              "name": "Size",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "send1_p2",
              "name": "Damping",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "send1_p3",
              "name": "Bigness",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "send1_return",
              "name": "Return",
              "type": "float",
              "min": 0.0,
              "max": 2.0,
              "step": 0.02
            }
          ],
          "knobs": [
            "send1_p1",
            "send1_p2",
            "send1_p3",
            "send1_return"
          ]
        },
        "send2": {
          "name": "Send 2",
          "params": [
            {
              "key": "send2_type",
              "name": "Type",
              "type": "enum",
              "options": [
                "Off",
                "Plate",
                "Room",
                "Hall"
              ]
            },
            {
              "key": "send2_p1",
              "name": "Size",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "send2_p2",
              "name": "Damping",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "send2_p3",
              "name": "Bigness",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            {
              "key": "send2_return",
              "name": "Return",
              "type": "float",
              "min": 0.0,
              "max": 2.0,
              "step": 0.02
            }
          ],
          "knobs": [
            "send2_p1",
            "send2_p2",
            "send2_p3",
            "send2_return"
          ]
        },
        "insert1": {
          "name": "Insert 1",
          "params": [
            {
              "key": "insert1_type",
              "name": "Type",
              "type": "enum",
              "options": [
                "Off",
                "Drum Buss",
                "Plate",
                "Room",
                "Hall"
              ]
            },
            {
              "key": "insert1_p1",
              "name": "Size",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert1_type",
                "not_equals": "Drum Buss"
              }
            },
            {
              "key": "insert1_p2",
              "name": "Damping",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert1_type",
                "not_equals": "Drum Buss"
              }
            },
            {
              "key": "insert1_p3",
              "name": "Bigness",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert1_type",
                "not_equals": "Drum Buss"
              }
            },
            {
              "key": "insert1_p1",
              "name": "Compress",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert1_type",
                "equals": "Drum Buss"
              }
            },
            {
              "key": "insert1_p2",
              "name": "Drive",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert1_type",
                "equals": "Drum Buss"
              }
            },
            {
              "key": "insert1_p3",
              "name": "Boom",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert1_type",
                "equals": "Drum Buss"
              }
            },
            {
              "key": "insert1_mix",
              "name": "Dry/Wet",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            }
          ],
          "knobs": [
            "insert1_p1",
            "insert1_p2",
            "insert1_p3",
            "insert1_mix"
          ]
        },
        "insert2": {
          "name": "Insert 2",
          "params": [
            {
              "key": "insert2_type",
              "name": "Type",
              "type": "enum",
              "options": [
                "Off",
                "Drum Buss",
                "Plate",
                "Room",
                "Hall"
              ]
            },
            {
              "key": "insert2_p1",
              "name": "Size",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert2_type",
                "not_equals": "Drum Buss"
              }
            },
            {
              "key": "insert2_p2",
              "name": "Damping",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert2_type",
                "not_equals": "Drum Buss"
              }
            },
            {
              "key": "insert2_p3",
              "name": "Bigness",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert2_type",
                "not_equals": "Drum Buss"
              }
            },
            {
              "key": "insert2_p1",
              "name": "Compress",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert2_type",
                "equals": "Drum Buss"
              }
            },
            {
              "key": "insert2_p2",
              "name": "Drive",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert2_type",
                "equals": "Drum Buss"
              }
            },
            {
              "key": "insert2_p3",
              "name": "Boom",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01,
              "visible_if": {
                "param": "insert2_type",
                "equals": "Drum Buss"
              }
            },
            {
              "key": "insert2_mix",
              "name": "Dry/Wet",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            }
          ],
          "knobs": [
            "insert2_p1",
            "insert2_p2",
            "insert2_p3",
            "insert2_mix"
          ]
        },
        "fx": {
          "name": "Effects",
          "params": [
            {
              "level": "send1",
              "label": "Send 1"
            },
            {
              "level": "send2",
              "label": "Send 2"
            },
            {
              "level": "insert1",
              "label": "Insert 1"
            },
            {
              "level": "insert2",
              "label": "Insert 2"
            }
          ],
          "knobs": []
        }
      }
    }
  }
}
